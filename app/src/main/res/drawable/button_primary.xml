<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#39C895" />
            <corners android:radius="16dp" />
            <padding android:left="20dp" android:top="14dp" android:right="20dp" android:bottom="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#52E4B2" android:endColor="#5CCBFF" />
            <corners android:radius="16dp" />
            <padding android:left="20dp" android:top="14dp" android:right="20dp" android:bottom="14dp" />
        </shape>
    </item>
</selector>
